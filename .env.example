APP_ENV=prod
APP_SECRET=change-me-generate-a-long-random-secret
APP_NAME="Vozi misko"

# Example for cPanel/MySQL. Replace values on hosting.
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.4.0&charset=utf8mb4"

# Example SMTP. Keep real credentials only on hosting, never in Git.
MAILER_DSN="smtp://user:password@smtp.example.com:587"

# AI document scanning. Leave empty if module is disabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1/chat/completions"
