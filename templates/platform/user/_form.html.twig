<div class="max-w-2xl">
    <div class="mb-4">
        <a href="{{ path('platform_user_index') }}" class="inline-flex items-center gap-2 text-sm text-muted hover:text-purple">
            <i class="ri-arrow-left-line"></i>
            Nazad na korisnike
        </a>
    </div>

    <section class="p-5 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10">
        <div class="mb-5">
            <h2 class="text-xl font-semibold text-black dark:text-white">{{ title }}</h2>
            <p class="mt-1 text-muted">{{ description }}</p>
        </div>

        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
            <div>
                {{ form_label(form.email, null, {label_attr: {class: 'block mb-2 text-sm font-medium text-black dark:text-white'}}) }}
                {{ form_widget(form.email, {attr: {class: 'w-full px-4 py-2.5 bg-transparent border rounded outline-none border-black/10 dark:border-darkborder'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    {{ form_label(form.firstName, null, {label_attr: {class: 'block mb-2 text-sm font-medium text-black dark:text-white'}}) }}
                    {{ form_widget(form.firstName, {attr: {class: 'w-full px-4 py-2.5 bg-transparent border rounded outline-none border-black/10 dark:border-darkborder'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div>
                    {{ form_label(form.lastName, null, {label_attr: {class: 'block mb-2 text-sm font-medium text-black dark:text-white'}}) }}
                    {{ form_widget(form.lastName, {attr: {class: 'w-full px-4 py-2.5 bg-transparent border rounded outline-none border-black/10 dark:border-darkborder'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>

            <div>
                {{ form_label(form.company, null, {label_attr: {class: 'block mb-2 text-sm font-medium text-black dark:text-white'}}) }}
                {{ form_widget(form.company, {attr: {class: 'w-full px-4 py-2.5 bg-transparent border rounded outline-none border-black/10 dark:border-darkborder'}}) }}
                {{ form_errors(form.company) }}
            </div>

            <div>
                {{ form_label(form.roles, null, {label_attr: {class: 'block mb-2 text-sm font-medium text-black dark:text-white'}}) }}
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
                    {% for child in form.roles %}
                        <label class="flex items-center gap-2 p-3 border rounded border-black/10 dark:border-darkborder">
                            {{ form_widget(child) }}
                            <span>{{ child.vars.label }}</span>
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.roles) }}
            </div>

            <div>
                {{ form_label(form.plainPassword, null, {label_attr: {class: 'block mb-2 text-sm font-medium text-black dark:text-white'}}) }}
                {{ form_widget(form.plainPassword, {attr: {class: 'w-full px-4 py-2.5 bg-transparent border rounded outline-none border-black/10 dark:border-darkborder'}}) }}
                {% if form.plainPassword.vars.help %}
                    <p class="mt-1 text-xs text-muted">{{ form.plainPassword.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.plainPassword) }}
            </div>

            <button type="submit" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-white rounded bg-purple">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 4v6h8M8 20v-6h8v6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                {{ button_label }}
            </button>
        {{ form_end(form) }}
    </section>
</div>
