{% extends 'base.html.twig' %}

{% block title %}Korisnici | {{ app_name }}{% endblock %}
{% block page_title %}Korisnici{% endblock %}

{% block body %}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-xl font-semibold text-black dark:text-white">Korisnici</h2>
            <p class="mt-1 text-muted">Platformski pregled korisnika i njihovih rola.</p>
        </div>
        <a href="{{ path('platform_user_new') }}" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-white rounded bg-purple">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
            Novi korisnik
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="p-3 mt-4 text-sm rounded text-success bg-success/10">
            {{ message }}
        </div>
    {% endfor %}

    <section class="p-5 mt-4 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10">
        <div class="overflow-auto">
            <table class="w-full min-w-[860px]">
                <thead>
                    <tr class="ltr:text-left rtl:text-right">
                        <th>Korisnik</th>
                        <th>Firma</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-right">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="text-muted">
                            <td>
                                <span class="block font-medium text-black dark:text-white">{{ user.fullName ?: user.email }}</span>
                                <span>{{ user.email }}</span>
                            </td>
                            <td>{{ user.company ? user.company.name : 'Platforma' }}</td>
                            <td>
                                <div class="flex flex-wrap gap-1">
                                    {% for role in user.roles|filter(role => role != 'ROLE_USER') %}
                                        <span class="px-2 py-1 text-xs rounded bg-info/10 text-info">{{ role }}</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td>
                                {% if user.active %}
                                    <span class="px-2 py-1 text-xs rounded bg-success/10 text-success">Aktivan</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs rounded bg-danger/10 text-danger">Neaktivan</span>
                                {% endif %}
                            </td>
                            <td class="text-right">
                                <a href="{{ path('platform_user_edit', {id: user.id}) }}" class="inline-flex items-center justify-center gap-2 px-3 py-2 rounded text-purple bg-purple/10">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M4 20h4l11-11a2.8 2.8 0 0 0-4-4L4 16v4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                        <path d="m13.5 6.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                    Uredi
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-8 text-center text-muted">Još nema kreiranih korisnika.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
