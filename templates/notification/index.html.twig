{% extends 'base.html.twig' %}

{% block title %}Notifikacije | {{ app_name }}{% endblock %}
{% block page_title %}Notifikacije{% endblock %}

{% block body %}
    <style>
        .notification-list {
            display: grid;
            gap: 0.75rem;
        }

        .notification-row {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: 110px minmax(120px, 170px) minmax(0, 1fr) 110px;
            align-items: center;
        }

        @media (max-width: 900px) {
            .notification-row {
                grid-template-columns: minmax(0, 1fr) auto;
                align-items: start;
            }

            .notification-row > div:nth-child(2) {
                grid-column: 1 / -1;
                grid-row: 2;
            }

            .notification-row > div:nth-child(3) {
                grid-column: 1 / -1;
                grid-row: 3;
            }

            .notification-row > div:nth-child(4) {
                grid-column: 2;
                grid-row: 1;
            }
        }
    </style>

    <div>
        <h2 class="text-xl font-semibold text-black dark:text-white">Notifikacije</h2>
        <p class="mt-1 text-muted">Historija slanja upozorenja za dokumente koji ističu.</p>
    </div>

    <section class="mt-4 rounded border border-black/10 bg-white p-3 dark:border-darkborder dark:bg-darklight">
        <div class="notification-list">
            {% for notification in notifications %}
                <article class="notification-row rounded border border-black/10 p-3 dark:border-darkborder">
                    <div>
                        <span class="inline-flex rounded bg-purple/10 px-2 py-1 text-xs font-semibold text-purple">{{ notification.channel|upper }}</span>
                    </div>
                    <div class="text-sm text-black dark:text-white">
                        {{ notification.sentAt ? notification.sentAt|date('d.m.Y H:i') : '-' }}
                    </div>
                    <div>
                        <p class="text-xs leading-5 text-muted">{{ notification.messageText }}</p>
                        {% if notification.recipient %}
                            <p class="mt-1 text-[11px] text-muted">Prima: {{ notification.recipient }}</p>
                        {% endif %}
                        {% if notification.failureReason %}
                            <p class="mt-1 text-[11px] text-danger">{{ notification.failureReason }}</p>
                        {% endif %}
                    </div>
                    <div>
                        {% if notification.status == 'sent' %}
                            <span class="inline-flex rounded bg-success/10 px-2 py-1 text-xs font-semibold text-success">Poslano</span>
                        {% elseif notification.status == 'failed' %}
                            <span class="inline-flex rounded bg-danger/10 px-2 py-1 text-xs font-semibold text-danger">Greška</span>
                        {% else %}
                            <span class="inline-flex rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">{{ notification.status }}</span>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <div class="rounded border border-dashed border-black/10 p-6 text-center text-muted dark:border-darkborder">
                    Još nema poslanih notifikacija.
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
