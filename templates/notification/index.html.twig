{% extends 'base.html.twig' %}

{% block title %}Obavijesti | {{ app_name }}{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <h2 class="text-xl font-semibold text-black dark:text-white">Obavijesti</h2>
            <p class="mt-1 text-muted">Vaša upozorenja o rokovima i važnim obavezama.</p>
        </div>
        {% if notifications|filter(item => not item.read)|length > 0 %}
            <form method="post" action="{{ path('notification_read_all') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
                <button class="inline-flex items-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple" type="submit">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m4 12 5 5L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Označi sve pročitanim
                </button>
            </form>
        {% endif %}
    </div>

    <section class="mt-4 grid gap-3 rounded bg-black/[0.025] p-3 dark:bg-white/[0.03]">
        {% for item in notifications %}
            <article class="flex flex-col gap-3 rounded border bg-white p-4 shadow-sm transition hover:border-purple/40 hover:shadow sm:flex-row sm:items-center {{ item.read ? 'border-black/10 dark:border-darkborder dark:bg-darklight' : 'border-purple/30 dark:bg-darklight' }}">
            <a href="{{ path('notification_open', {id: item.id, source: 'inbox'}) }}" class="flex min-w-0 flex-1 gap-3">
                <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded bg-purple/10 text-purple">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3a6 6 0 0 0-6 6v3.2L4.5 15a1 1 0 0 0 .9 1.5h13.2a1 1 0 0 0 .9-1.5L18 12.2V9a6 6 0 0 0-6-6Z" stroke="currentColor" stroke-width="1.8"/><path d="M9.8 19a2.5 2.5 0 0 0 4.4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </span>
                <span class="min-w-0 flex-1">
                    <span class="flex items-start justify-between gap-3">
                        <strong class="text-sm text-black dark:text-white">{{ item.title }}</strong>
                        {% if not item.read %}<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-purple"></span>{% endif %}
                    </span>
                    <span class="mt-1 block text-xs leading-5 text-muted">{{ item.messageText|nl2br }}</span>
                    <time class="mt-2 block text-[11px] text-muted">{{ item.createdAt|date('d.m.Y H:i') }}</time>
                    {% if item.deliveryChannels %}
                        <span class="mt-2 flex flex-wrap gap-1">
                            {% for channel in item.deliveryChannels %}
                                <span class="inline-flex rounded px-2 py-1 text-[10px] font-semibold {{ channel == 'email' ? 'bg-info/10 text-info' : 'bg-purple/10 text-purple' }}">{{ channel == 'email' ? 'EMAIL' : 'WEB PUSH' }}</span>
                            {% endfor %}
                        </span>
                    {% endif %}
                </span>
            </a>
            {% if item.documentRenewalAvailable %}
                <button type="button"
                        class="inline-flex shrink-0 self-start items-center justify-center gap-1.5 rounded border border-purple/20 bg-purple/5 px-2.5 py-1.5 text-[11px] font-semibold text-purple shadow-sm transition hover:border-purple/40 hover:bg-purple/10 sm:self-center"
                        data-renew-notification
                        data-renew-url="{{ path('notification_renew', {id: item.id}) }}"
                        data-renew-token="{{ csrf_token('renew_notification_' ~ item.id) }}"
                        data-renew-title="{{ item.document.typeLabel }}"
                        data-renew-owner="{{ item.document.ownerLabel }}"
                        data-renew-current="{{ item.document.validUntil|date('d.m.Y') }}"
                        data-renew-min="{{ item.document.validUntil|date_modify('+1 day')|date('Y-m-d') }}">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M8 3v4M16 3v4M3 10h18M8 15l2.2 2L16 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Produži
                </button>
            {% endif %}
            </article>
        {% else %}
            <div class="rounded border border-dashed border-black/10 bg-white p-8 text-center text-muted shadow-sm dark:border-darkborder dark:bg-darklight">Još nema obavijesti.</div>
        {% endfor %}
    </section>
{% endblock %}
