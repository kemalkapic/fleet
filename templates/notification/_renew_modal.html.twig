<dialog id="notification-renew-dialog" class="notification-renew-dialog rounded-lg border-0 bg-white p-0 shadow-2xl backdrop:bg-black/60 dark:bg-darklight">
    <form method="post" id="notification-renew-form">
        <div class="flex items-center justify-between border-b border-black/10 px-4 py-3 dark:border-darkborder">
            <div>
                <h2 class="text-sm font-semibold text-black dark:text-white">Produži rok evidencije</h2>
                <p class="mt-0.5 text-[11px] text-muted" id="notification-renew-owner"></p>
            </div>
            <button type="button" class="inline-flex size-8 items-center justify-center rounded bg-black/5 text-lg text-muted hover:text-black dark:bg-white/10 dark:hover:text-white" data-renew-close aria-label="Zatvori">
                <i class="ri-close-line" aria-hidden="true"></i>
            </button>
        </div>
        <div class="space-y-3 p-4">
            <div class="rounded border border-purple/15 bg-purple/5 px-3 py-2 text-xs">
                <strong class="block text-xs text-black dark:text-white" id="notification-renew-title"></strong>
                <span class="mt-0.5 block text-[11px] text-muted">Trenutni rok: <span id="notification-renew-current"></span></span>
            </div>
            <div>
                <label for="notification-renew-date" class="mb-1 block text-[11px] font-semibold text-black dark:text-white">Novi datum isteka</label>
                <input type="date" id="notification-renew-date" name="validUntil" required class="form-input w-full rounded border border-black/10 px-3 py-2 text-xs dark:border-darkborder dark:bg-dark">
            </div>
            <input type="hidden" name="_token" id="notification-renew-token">
        </div>
        <div class="flex items-center justify-end gap-2 border-t border-black/10 px-4 py-3 dark:border-darkborder">
            <button type="button" class="inline-flex items-center justify-center rounded px-3 py-2 text-xs font-semibold text-muted transition hover:bg-black/5 hover:text-black dark:hover:bg-white/10 dark:hover:text-white" data-renew-close>Odustani</button>
            <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded bg-purple px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-purple/90">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 4h12l2 2v14H5V4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M8 4v6h8V4M8 20v-6h8v6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                Spremi
            </button>
        </div>
    </form>
</dialog>

<script>
    (() => {
        const dialog = document.getElementById('notification-renew-dialog');
        const form = document.getElementById('notification-renew-form');
        const title = document.getElementById('notification-renew-title');
        const owner = document.getElementById('notification-renew-owner');
        const current = document.getElementById('notification-renew-current');
        const date = document.getElementById('notification-renew-date');
        const token = document.getElementById('notification-renew-token');

        if (!dialog || !form || !title || !owner || !current || !date || !token) {
            return;
        }

        document.addEventListener('click', (event) => {
            const openButton = event.target.closest('[data-renew-notification]');
            if (openButton) {
                form.action = openButton.dataset.renewUrl;
                title.textContent = openButton.dataset.renewTitle;
                owner.textContent = openButton.dataset.renewOwner;
                current.textContent = openButton.dataset.renewCurrent;
                date.min = openButton.dataset.renewMin;
                date.value = '';
                token.value = openButton.dataset.renewToken;
                dialog.showModal();
                return;
            }

            if (event.target.closest('[data-renew-close]')) {
                dialog.close();
            }
        });

        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
    })();
</script>
