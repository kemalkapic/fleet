{% extends 'base.html.twig' %}

{% block title %}Vozači | {{ app_name }}{% endblock %}
{% block page_title %}Vozači{% endblock %}

{% block body %}
    {% set status_labels = {
        active: 'Aktivan',
        inactive: 'Neaktivan'
    } %}

    <style>
        .driver-card-details {
            display: grid;
            gap: 0.55rem 0.75rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @media (max-width: 768px) {
            .driver-card-details {
                gap: 0.4rem 0.6rem;
            }

            .driver-card-details dt {
                font-size: 0.625rem;
            }

            .driver-card-details dd {
                font-size: 0.78rem;
                line-height: 1.15rem;
            }

            .driver-card-details > div:nth-child(n+5) {
                display: none;
            }
        }
    </style>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-xl font-semibold text-black dark:text-white">Vozači</h2>
            <p class="mt-1 text-muted">Vozači dostupni u vašoj firmi.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if driver_limit_reached %}
                <span class="inline-flex w-full items-center justify-center rounded bg-warning/10 px-4 py-2 text-sm font-semibold text-warning sm:w-auto">
                    Kontaktiraj admina za još vozača
                </span>
            {% else %}
                <a href="{{ path('driver_new') }}" class="inline-flex w-full items-center justify-center gap-2 px-4 py-2 text-white rounded bg-purple sm:w-auto">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                    Novi vozač
                </a>
            {% endif %}
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="p-3 mt-4 text-sm rounded text-success bg-success/10">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="p-3 mt-4 text-sm rounded text-danger bg-danger/10">
            {{ message }}
        </div>
    {% endfor %}

    <section class="mt-4">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
            {% for driver in drivers %}
                <article class="flex flex-col rounded border border-black/10 bg-white p-4 dark:border-darkborder dark:bg-darklight">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="truncate text-base font-semibold text-black dark:text-white sm:text-lg">{{ driver.fullName }}</p>
                            <p class="mt-0.5 truncate text-xs text-muted sm:mt-1 sm:text-sm">{{ driver.phone ?: 'Telefon nije upisan' }}</p>
                        </div>
                        <span class="flex-none rounded bg-info/10 px-2 py-1 text-xs font-semibold text-info">{{ status_labels[driver.status]|default(driver.status) }}</span>
                    </div>

                    <dl class="driver-card-details mt-3 text-sm">
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Email</dt>
                            <dd class="mt-1 break-all text-black dark:text-white">{{ driver.email ?: '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Rođenje</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.birthDate ? driver.birthDate|date('d.m.Y') : '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Mjesto</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.birthPlace ?: '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Vozačka</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.licenceNumber ?: '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Kategorije</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.licenceCategories ? driver.licenceCategories|join(', ') : '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Važi do</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.licenceExpiresAt ? driver.licenceExpiresAt|date('d.m.Y') : '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Izdano</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.licenceIssuedAt ? driver.licenceIssuedAt|date('d.m.Y') : '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Organ</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.licenceIssuedBy ?: '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] font-semibold uppercase text-muted">Općina</dt>
                            <dd class="mt-1 text-black dark:text-white">{{ driver.residenceMunicipality ?: '-' }}</dd>
                        </div>
                    </dl>

                    <div class="mt-3 flex items-end gap-2">
                        <a href="{{ path('driver_edit', {id: driver.id}) }}" class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M4 20h4l11-11a2.8 2.8 0 0 0-4-4L4 16v4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="m13.5 6.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            Uredi
                        </a>
                        <form method="post" action="{{ path('driver_delete', {id: driver.id}) }}" class="flex-1" onsubmit="return confirm('Jeste li sigurni da želite obrisati ovog vozača?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_driver_' ~ driver.id) }}">
                            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded bg-danger/10 px-3 py-2 text-sm font-semibold text-danger">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M6 7h12M10 11v6M14 11v6M9 7l1-3h4l1 3M8 7l1 13h6l1-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                Obriši
                            </button>
                        </form>
                    </div>
                </article>
            {% else %}
                <div class="rounded border border-dashed border-black/10 bg-white p-6 text-center text-muted dark:border-darkborder dark:bg-darklight md:col-span-2 xl:col-span-3">
                    Još nema kreiranih vozača.
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="hidden">
        <div class="hidden overflow-auto sm:block">
            <table class="w-full min-w-[760px]">
                <thead>
                    <tr class="ltr:text-left rtl:text-right">
                        <th>Vozač</th>
                        <th>Telefon</th>
                        <th>Email</th>
                        <th>Vozačka</th>
                        <th>Status</th>
                        <th class="text-right">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    {% for driver in drivers %}
                        <tr class="text-muted">
                            <td>
                                <span class="font-medium text-black dark:text-white">{{ driver.fullName }}</span>
                            </td>
                            <td>{{ driver.phone ?: '-' }}</td>
                            <td>{{ driver.email ?: '-' }}</td>
                            <td>
                                {% if driver.licenceCategories or driver.licenceExpiresAt %}
                                    {{ driver.licenceCategories ? driver.licenceCategories|join(', ') : '-' }}
                                    {% if driver.licenceExpiresAt %}
                                        <span class="block text-xs text-muted">Važi do {{ driver.licenceExpiresAt|date('d.m.Y') }}</span>
                                    {% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td><span class="px-2 py-1 text-xs rounded bg-info/10 text-info">{{ status_labels[driver.status]|default(driver.status) }}</span></td>
                            <td class="text-right">
                                <a href="{{ path('driver_edit', {id: driver.id}) }}" class="inline-flex items-center justify-center px-3 py-2 rounded text-purple bg-purple/10">
                                    Uredi
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-8 text-center text-muted">Još nema kreiranih vozača.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="space-y-3 sm:hidden">
            {% for driver in drivers %}
                <article class="rounded border border-black/10 bg-white p-4 dark:border-darkborder dark:bg-dark">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="truncate text-base font-semibold text-black dark:text-white">{{ driver.fullName }}</p>
                            <p class="mt-1 text-sm text-muted">{{ driver.phone ?: 'Telefon nije upisan' }}</p>
                        </div>
                        <span class="flex-none rounded bg-info/10 px-2 py-1 text-xs text-info">{{ status_labels[driver.status]|default(driver.status) }}</span>
                    </div>

                    <dl class="mt-4 grid grid-cols-1 gap-3 text-sm">
                        <div>
                            <dt class="text-xs uppercase text-muted">Email</dt>
                            <dd class="mt-1 break-all text-black dark:text-white">{{ driver.email ?: '-' }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs uppercase text-muted">Vozačka</dt>
                            <dd class="mt-1 text-black dark:text-white">
                                {% if driver.licenceCategories or driver.licenceExpiresAt %}
                                    {{ driver.licenceCategories ? driver.licenceCategories|join(', ') : '-' }}
                                    {% if driver.licenceExpiresAt %}
                                        <span class="block text-xs text-muted">Važi do {{ driver.licenceExpiresAt|date('d.m.Y') }}</span>
                                    {% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </dd>
                        </div>
                    </dl>

                    <a href="{{ path('driver_edit', {id: driver.id}) }}" class="mt-4 inline-flex w-full items-center justify-center px-3 py-2 rounded text-purple bg-purple/10">
                        Uredi
                    </a>
                </article>
            {% else %}
                <div class="rounded border border-dashed border-black/10 p-6 text-center text-muted dark:border-darkborder">
                    Još nema kreiranih vozača.
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
