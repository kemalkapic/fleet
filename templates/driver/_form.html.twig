{% set field_label_class = 'block mb-1 text-xs font-medium text-black dark:text-white' %}
{% set field_input_class = 'w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder' %}
{% set embedded = embedded|default(false) %}

<style>
    .driver-form-layout {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: minmax(0, 1fr);
    }

    .driver-form-fields {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: minmax(0, 1fr);
    }

    .document-scan-file input[type="file"] {
        width: 100%;
        font-size: 0.875rem;
    }

    .document-scan-file input[type="file"]::file-selector-button {
        margin-right: 0.75rem;
        border: 0;
        border-radius: 6px;
        background: #6a5af9;
        color: #fff;
        padding: 0.5rem 0.75rem;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
    }

    @media (min-width: 768px) {
        .driver-form-fields {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1024px) {
        .driver-form-layout {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .driver-form-fields {
            grid-column: span 3 / span 3;
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>

<div class="w-full">
    {% if not embedded %}
    <div class="mb-4">
        <a href="{{ path('driver_index') }}" class="inline-flex items-center gap-2 text-sm text-muted hover:text-purple">
            <i class="ri-arrow-left-line"></i>
            Nazad na vozače
        </a>
    </div>
    {% endif %}

    {% if embedded %}
        <div>
    {% else %}
        <section class="p-3 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-4">
    {% endif %}
        <div class="mb-4">
            <h2 class="text-lg font-semibold text-black dark:text-white">{{ title }}</h2>
            <p class="mt-1 text-sm text-muted">{{ description }}</p>
        </div>

        {{ form_start(form, {attr: {class: 'space-y-3'}}) }}
            {% if scan_enabled|default(false) %}
                <div class="rounded border border-purple/20 bg-purple/10 p-3" data-document-scan data-scan-url="{{ scan_url }}">
                    <div>
                        <div class="min-w-0">
                            <h3 class="text-sm font-semibold text-black dark:text-white">{{ scan_title }}</h3>
                            <p class="mt-1 text-xs text-muted">{{ scan_description }}</p>
                            <p class="mt-2 inline-flex rounded bg-info/10 px-2 py-1 text-xs font-semibold text-info">
                                Za prepoznavanje teksta sa slika koristi se umjetna inteligencija.
                            </p>
                        </div>

                        <div class="document-scan-file mt-3 rounded border border-purple/20 bg-white p-3">
                            <input type="file" accept="image/jpeg,image/png,image/webp" data-scan-input>
                        </div>
                    </div>

                    <div class="mt-3 hidden rounded border border-purple/20 bg-white p-3" data-scan-progress>
                        <div class="mb-2 flex items-center justify-between gap-3">
                            <span class="text-sm font-semibold text-black dark:text-white">Čitam dokument</span>
                            <span class="text-xs text-muted">AI obrada u toku</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-purple" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="mt-3 hidden rounded bg-white px-3 py-2 text-sm text-muted" data-scan-status></div>
                    <div class="mt-3 hidden flex-wrap gap-2" data-scan-warnings></div>
                </div>
            {% endif %}

            <div class="driver-form-layout">
                <div class="driver-form-fields">
                <div>
                    {{ form_label(form.firstName, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.firstName, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div>
                    {{ form_label(form.lastName, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.lastName, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.lastName) }}
                </div>

                <div>
                    {{ form_label(form.phone, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.phone, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.phone) }}
                </div>

                <div>
                    {{ form_label(form.email, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.email, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div>
                    {{ form_label(form.birthDate, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.birthDate, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.birthDate) }}
                </div>

                <div>
                    {{ form_label(form.birthPlace, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.birthPlace, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.birthPlace) }}
                </div>

                <div>
                    {{ form_label(form.licenceNumber, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.licenceNumber, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.licenceNumber) }}
                </div>

                <div>
                    {{ form_label(form.licenceCategories, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.licenceCategories, {attr: {class: field_input_class, placeholder: 'B, C, CE'}}) }}
                    {{ form_errors(form.licenceCategories) }}
                </div>

                <div>
                    {{ form_label(form.licenceIssuedAt, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.licenceIssuedAt, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.licenceIssuedAt) }}
                </div>

                <div>
                    {{ form_label(form.licenceExpiresAt, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.licenceExpiresAt, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.licenceExpiresAt) }}
                </div>

                <div>
                    {{ form_label(form.licenceIssuedBy, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.licenceIssuedBy, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.licenceIssuedBy) }}
                </div>

                <div>
                    {{ form_label(form.residenceMunicipality, null, {label_attr: {class: field_label_class}}) }}
                    {{ form_widget(form.residenceMunicipality, {attr: {class: field_input_class}}) }}
                    {{ form_errors(form.residenceMunicipality) }}
                </div>
                </div>

                <div class="space-y-3">
                    <div>
                        {{ form_label(form.status, null, {label_attr: {class: field_label_class}}) }}
                        {{ form_widget(form.status, {attr: {class: field_input_class}}) }}
                        {{ form_errors(form.status) }}
                    </div>

                    <div>
                        {{ form_label(form.notes, null, {label_attr: {class: field_label_class}}) }}
                        {{ form_widget(form.notes, {attr: {class: field_input_class ~ ' min-h-36 resize-y'}}) }}
                        {{ form_errors(form.notes) }}
                    </div>

                    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded bg-purple px-4 py-2 text-sm text-white">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 4v6h8M8 20v-6h8v6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                        {{ button_label }}
                    </button>
                </div>
            </div>
        {{ form_end(form) }}
    {% if embedded %}
        </div>
    {% else %}
        </section>
    {% endif %}
</div>

{% if false and scan_enabled|default(false) %}
    <script>
        (() => {
            const panel = document.querySelector('[data-document-scan]');
            if (!panel) {
                return;
            }

            const form = panel.closest('form');
            const input = panel.querySelector('[data-scan-input]');
            const button = panel.querySelector('[data-scan-button]');
            const status = panel.querySelector('[data-scan-status]');
            const warnings = panel.querySelector('[data-scan-warnings]');

            const showStatus = (message, isError = false) => {
                status.textContent = message;
                status.classList.remove('hidden', 'text-danger', 'text-success');
                status.classList.add(isError ? 'text-danger' : 'text-success');
            };

            const fillField = (field, value) => {
                if (value === null || value === undefined || value === '') {
                    return;
                }

                const element = form.querySelector(`[name$="[${field}]"]`);
                if (element) {
                    element.value = value;
                    element.dispatchEvent(new Event('change', { bubbles: true }));
                }
            };

            button.addEventListener('click', () => input.click());

            input.addEventListener('change', async () => {
                const file = input.files && input.files[0];
                if (!file) {
                    return;
                }

                const body = new FormData();
                body.append('document', file);
                button.disabled = true;
                status.classList.add('hidden');
                warnings.classList.add('hidden');
                warnings.innerHTML = '';

                try {
                    const response = await fetch(panel.dataset.scanUrl, {
                        method: 'POST',
                        body,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    const payload = await response.json();

                    if (!response.ok) {
                        throw new Error(payload.message || 'Nisam uspio pročitati dokument.');
                    }

                    Object.entries(payload.fields || {}).forEach(([field, value]) => fillField(field, value));

                    if ((payload.warnings || []).length > 0) {
                        warnings.classList.remove('hidden');
                        warnings.classList.add('flex');
                        payload.warnings.forEach((warning) => {
                            const badge = document.createElement('span');
                            badge.className = 'inline-flex rounded bg-warning/10 px-3 py-1 text-xs font-semibold text-warning';
                            badge.textContent = warning;
                            warnings.appendChild(badge);
                        });
                    }

                    showStatus('Polja su popunjena. Provjerite podatke prije čuvanja.');
                } catch (error) {
                    showStatus(error.message, true);
                } finally {
                    button.disabled = false;
                    input.value = '';
                }
            });
        })();
    </script>
{% endif %}

{% if scan_enabled|default(false) %}
    <script>
        (() => {
            const panel = document.querySelector('[data-document-scan]');
            if (!panel) {
                return;
            }

            const form = panel.closest('form');
            const input = panel.querySelector('[data-scan-input]');
            const progress = panel.querySelector('[data-scan-progress]');
            const status = panel.querySelector('[data-scan-status]');
            const warnings = panel.querySelector('[data-scan-warnings]');

            if (!form || !input || !progress || !status || !warnings) {
                return;
            }

            const showStatus = (message, isError = false) => {
                status.textContent = message;
                status.classList.remove('hidden', 'text-danger', 'text-success');
                status.classList.add(isError ? 'text-danger' : 'text-success');
            };

            const fillField = (field, value) => {
                if (value === null || value === undefined || value === '') {
                    return;
                }

                const element = form.querySelector(`[name$="[${field}]"]`);
                if (element) {
                    element.value = value;
                    element.dispatchEvent(new Event('change', { bubbles: true }));
                }
            };

            const scanFile = async (file) => {
                if (!file) {
                    return;
                }

                const body = new FormData();
                body.append('document', file);
                input.disabled = true;
                progress.classList.remove('hidden');
                showStatus('Čitam dokument...');
                warnings.classList.add('hidden');
                warnings.innerHTML = '';

                try {
                    const response = await fetch(panel.dataset.scanUrl, {
                        method: 'POST',
                        body,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    });
                    const payload = await response.json();

                    if (!response.ok) {
                        throw new Error(payload.message || 'Nisam uspio pročitati dokument.');
                    }

                    Object.entries(payload.fields || {}).forEach(([field, value]) => fillField(field, value));

                    if ((payload.warnings || []).length > 0) {
                        warnings.classList.remove('hidden');
                        warnings.classList.add('flex');
                        payload.warnings.forEach((warning) => {
                            const badge = document.createElement('span');
                            badge.className = 'inline-flex rounded bg-warning/10 px-3 py-1 text-xs font-semibold text-warning';
                            badge.textContent = warning;
                            warnings.appendChild(badge);
                        });
                    }

                    showStatus('Polja su popunjena. Provjerite podatke prije čuvanja.');
                } catch (error) {
                    showStatus(error.message, true);
                } finally {
                    input.disabled = false;
                    input.value = '';
                    progress.classList.add('hidden');
                }
            };

            input.addEventListener('change', () => {
                const file = input.files && input.files[0];
                scanFile(file);
            });
        })();
    </script>
{% endif %}
