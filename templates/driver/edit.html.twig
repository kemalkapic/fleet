{% extends 'base.html.twig' %}

{% block title %}Uredi vozača | {{ app_name }}{% endblock %}
{% block page_title %}Uredi vozača{% endblock %}

{% block body %}
    <style>
        .driver-edit-tabs { display: grid; gap: 0.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .driver-edit-tab { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 2.5rem; border-radius: 0.375rem; border: 1px solid rgb(0 0 0 / 0.08); padding: 0.45rem 0.55rem; font-size: 0.8125rem; font-weight: 700; color: rgb(100 116 139); background: #fff; }
        .driver-edit-tab svg { width: 1.05rem; height: 1.05rem; flex: 0 0 auto; }
        .driver-edit-tab.is-active { border-color: rgb(109 91 255 / 0.28); color: rgb(109 91 255); background: rgb(109 91 255 / 0.1); }
        .driver-edit-panel { display: none; }
        .driver-edit-panel.is-active { display: block; }
        @media (min-width: 768px) { .driver-edit-tabs { display: flex; overflow-x: auto; padding-bottom: 0.25rem; } .driver-edit-tab { justify-content: flex-start; white-space: nowrap; padding: 0.55rem 0.8rem; font-size: 0.875rem; } .driver-edit-tab svg { width: 1.25rem; height: 1.25rem; } }
    </style>

    <div class="w-full">
        <div class="mb-4">
            <a href="{{ path('driver_index') }}" class="inline-flex items-center gap-2 text-sm text-muted hover:text-purple">
                <span aria-hidden="true">←</span>
                Nazad na vozače
            </a>
        </div>

        <section class="p-3 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-4" data-driver-edit-tabs>
            <div class="mb-4">
                <h2 class="text-lg font-semibold text-black dark:text-white">{{ driver.fullName }}</h2>
                <p class="mt-1 text-sm text-muted">Uredite podatke i dokumente za ovog vozača.</p>
            </div>

            <div class="driver-edit-tabs mb-4" role="tablist">
                <button type="button" class="driver-edit-tab is-active" data-tab-target="driver-basic" role="tab">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Osnovni podaci
                </button>
                <button type="button" class="driver-edit-tab" data-tab-target="driver-documents" role="tab">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3h7l4 4v14H7V3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 3v5h5M9 13h6M9 17h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Dokumenti
                </button>
            </div>

            <div id="driver-basic" class="driver-edit-panel is-active">
                {% include 'driver/_form.html.twig' with {
                    title: 'Osnovni podaci',
                    description: 'Ažurirajte osnovne podatke o vozaču.',
                    button_label: 'Sačuvaj promjene',
                    embedded: true
                } %}
            </div>

            <div id="driver-documents" class="driver-edit-panel">
                <div class="mb-3 flex justify-end">
                    <a href="{{ path('document_new', {driver: driver.id}) }}" class="inline-flex items-center justify-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                        Novi dokument
                    </a>
                </div>

                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                    {% for document in documents %}
                        {% set today = date('today') %}
                        {% set expiry_diff = today.diff(document.validUntil) %}
                        {% set days_left = expiry_diff.invert ? -expiry_diff.days : expiry_diff.days %}
                        {% set is_expired = days_left < 0 %}
                        {% set is_soon = days_left >= 0 and days_left <= 30 %}

                        <article class="rounded border border-black/10 p-3 dark:border-darkborder">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-black dark:text-white">{{ document.typeLabel }}</p>
                                    <p class="mt-1 text-xs text-muted">{{ document.documentNumber ?: 'Bez broja dokumenta' }}</p>
                                </div>
                                {% if is_expired %}
                                    <span class="rounded bg-danger/10 px-2 py-1 text-xs font-semibold text-danger">Isteklo</span>
                                {% elseif is_soon %}
                                    <span class="rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">Uskoro</span>
                                {% else %}
                                    <span class="rounded bg-success/10 px-2 py-1 text-xs font-semibold text-success">Aktivno</span>
                                {% endif %}
                            </div>

                            <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Važi od</dt><dd class="mt-1 text-black dark:text-white">{{ document.validFrom ? document.validFrom|date('d.m.Y') : '-' }}</dd></div>
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Ističe</dt><dd class="mt-1 font-semibold text-black dark:text-white">{{ document.validUntil|date('d.m.Y') }}</dd></div>
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Prilog</dt><dd class="mt-1 text-black dark:text-white">{{ document.storageKey ? 'Da' : 'Ne' }}</dd></div>
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Dana</dt><dd class="mt-1 text-black dark:text-white">{% if is_expired %}{{ days_left|abs }} dana prošlo{% else %}{{ days_left }} dana{% endif %}</dd></div>
                            </dl>

                            <div class="mt-3 flex gap-2">
                                {% if document.storageKey %}
                                    <a href="{{ path('document_download', {id: document.id}) }}" class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-info/10 px-3 py-2 text-sm font-semibold text-info">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        Preuzmi
                                    </a>
                                {% endif %}
                                <a href="{{ path('document_edit', {id: document.id}) }}" class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M4 20h4l11-11a2.8 2.8 0 0 0-4-4L4 16v4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                        <path d="m13.5 6.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                    Uredi
                                </a>
                            </div>
                        </article>
                    {% else %}
                        <div class="rounded border border-dashed border-black/10 p-6 text-center text-sm text-muted dark:border-darkborder md:col-span-2 xl:col-span-3">Ovaj vozač još nema unesenih dokumenata.</div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>

    <script>
        (() => {
            const root = document.querySelector('[data-driver-edit-tabs]');
            if (!root) return;
            const tabs = Array.from(root.querySelectorAll('[data-tab-target]'));
            const panels = Array.from(root.querySelectorAll('.driver-edit-panel'));
            const activate = (id) => {
                tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.tabTarget === id));
                panels.forEach((panel) => panel.classList.toggle('is-active', panel.id === id));
            };
            tabs.forEach((tab) => tab.addEventListener('click', () => {
                activate(tab.dataset.tabTarget);
                window.history.replaceState(null, '', `#${tab.dataset.tabTarget}`);
            }));
            if (window.location.hash) {
                const id = window.location.hash.replace('#', '');
                if (panels.some((panel) => panel.id === id)) activate(id);
            }
        })();
    </script>
{% endblock %}
