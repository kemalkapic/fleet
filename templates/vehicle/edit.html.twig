{% extends 'base.html.twig' %}

{% block title %}Uredi vozilo | {{ app_name }}{% endblock %}
{% block page_title %}Uredi vozilo{% endblock %}

{% block body %}
    <style>
        .vehicle-edit-tabs { display: grid; gap: 0.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .vehicle-edit-tab { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 2.5rem; border-radius: 0.375rem; border: 1px solid rgb(0 0 0 / 0.08); padding: 0.45rem 0.55rem; font-size: 0.8125rem; font-weight: 700; color: rgb(100 116 139); background: #fff; }
        .vehicle-edit-tab svg { width: 1.05rem; height: 1.05rem; flex: 0 0 auto; }
        .vehicle-edit-tab.is-active { border-color: rgb(109 91 255 / 0.28); color: rgb(109 91 255); background: rgb(109 91 255 / 0.1); }
        .vehicle-edit-panel { display: none; }
        .vehicle-edit-panel.is-active { display: block; }
        .vehicle-tire-grid { display: grid; gap: 0.65rem; grid-template-columns: minmax(0, 1fr); }
        .vehicle-fuel-row { display: grid; gap: 0.75rem; grid-template-columns: minmax(120px, 1fr) minmax(120px, 1fr) minmax(120px, 1fr) minmax(130px, 1fr) auto; align-items: center; }
        .vehicle-fuel-modal-backdrop { position: fixed; inset: 0; z-index: 10000; display: none; align-items: center; justify-content: center; padding: 1rem; background: rgba(15, 23, 42, 0.55); }
        .vehicle-fuel-modal-backdrop.is-open { display: flex; }
        .vehicle-fuel-modal { width: min(100%, 520px); border-radius: 8px; background: #fff; border: 1px solid rgba(0, 0, 0, 0.1); padding: 1rem; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22); }
        @media (min-width: 768px) { .vehicle-edit-tabs { display: flex; overflow-x: auto; padding-bottom: 0.25rem; } .vehicle-edit-tab { justify-content: flex-start; white-space: nowrap; padding: 0.55rem 0.8rem; font-size: 0.875rem; } .vehicle-edit-tab svg { width: 1.25rem; height: 1.25rem; } }
        @media (min-width: 768px) { .vehicle-tire-grid { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr) minmax(0, 0.9fr) minmax(0, 0.7fr) auto; align-items: end; } }
        @media (max-width: 900px) { .vehicle-fuel-row { grid-template-columns: 1fr; align-items: start; } }
    </style>

    <div class="w-full">
        <div class="mb-4">
            <a href="{{ path('vehicle_index') }}" class="inline-flex items-center gap-2 text-sm text-muted hover:text-purple">
                <i class="ri-arrow-left-line"></i>
                Nazad na vozila
            </a>
        </div>

        <section class="p-3 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-4" data-vehicle-edit-tabs>
            <div class="mb-4">
                <div>
                    <h2 class="text-lg font-semibold text-black dark:text-white">{{ vehicle.registrationNumber }}</h2>
                    <p class="mt-1 text-sm text-muted">Uredite podatke, dokumente i gume za ovo vozilo.</p>
                </div>
            </div>

            {% for message in app.flashes('success') %}
                <div class="mb-4 rounded bg-success/10 p-3 text-sm text-success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="mb-4 rounded bg-danger/10 p-3 text-sm text-danger">{{ message }}</div>
            {% endfor %}

            <div class="vehicle-edit-tabs mb-4" role="tablist">
                <button type="button" class="vehicle-edit-tab is-active" data-tab-target="vehicle-basic" role="tab">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 13h16l-2-5H6l-2 5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M6 13v5M18 13v5M7 18h2M15 18h2M8 8V6h8v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    Osnovni podaci
                </button>
                <button type="button" class="vehicle-edit-tab" data-tab-target="vehicle-documents" role="tab">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 3h7l4 4v14H7V3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M14 3v5h5M9 13h6M9 17h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    Dokumenti
                </button>
                <button type="button" class="vehicle-edit-tab" data-tab-target="vehicle-tires" role="tab">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2"/>
                        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                    </svg>
                    Gume
                </button>
                <button type="button" class="vehicle-edit-tab" data-tab-target="vehicle-fuel" role="tab">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M6 21V4a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v17M5 21h11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 7h3M15 8h2l2 2v7a2 2 0 0 0 4 0v-5l-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Gorivo
                </button>
            </div>

            <div id="vehicle-basic" class="vehicle-edit-panel is-active">
                {% include 'vehicle/_form.html.twig' with {
                    title: 'Osnovni podaci',
                    description: 'Ažurirajte osnovne podatke o vozilu.',
                    button_label: 'Sačuvaj promjene',
                    embedded: true
                } %}
            </div>

            <div id="vehicle-documents" class="vehicle-edit-panel">
                <div class="mb-3 flex justify-end">
                    <a href="{{ path('document_new', {vehicle: vehicle.id}) }}" class="inline-flex items-center justify-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                        </svg>
                        Novi dokument
                    </a>
                </div>

                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                    {% for document in documents %}
                        {% set today = date('today') %}
                        {% set expiry_diff = today.diff(document.validUntil) %}
                        {% set days_left = expiry_diff.invert ? -expiry_diff.days : expiry_diff.days %}
                        {% set is_expired = days_left < 0 %}
                        {% set is_soon = days_left >= 0 and days_left <= 30 %}

                        <article class="rounded border border-black/10 p-3 dark:border-darkborder">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-black dark:text-white">{{ document.typeLabel }}</p>
                                    <p class="mt-1 text-xs text-muted">{{ document.documentNumber ?: 'Bez broja dokumenta' }}</p>
                                </div>
                                {% if is_expired %}
                                    <span class="rounded bg-danger/10 px-2 py-1 text-xs font-semibold text-danger">Isteklo</span>
                                {% elseif is_soon %}
                                    <span class="rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">Uskoro</span>
                                {% else %}
                                    <span class="rounded bg-success/10 px-2 py-1 text-xs font-semibold text-success">Aktivno</span>
                                {% endif %}
                            </div>

                            <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Važi od</dt><dd class="mt-1 text-black dark:text-white">{{ document.validFrom ? document.validFrom|date('d.m.Y') : '-' }}</dd></div>
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Ističe</dt><dd class="mt-1 font-semibold text-black dark:text-white">{{ document.validUntil|date('d.m.Y') }}</dd></div>
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Prilog</dt><dd class="mt-1 text-black dark:text-white">{{ document.storageKey ? 'Da' : 'Ne' }}</dd></div>
                                <div><dt class="text-[11px] font-semibold uppercase text-muted">Dana</dt><dd class="mt-1 text-black dark:text-white">{% if is_expired %}{{ days_left|abs }} dana prošlo{% else %}{{ days_left }} dana{% endif %}</dd></div>
                            </dl>

                            <div class="mt-3 flex gap-2">
                                {% if document.storageKey %}
                                    <a href="{{ path('document_download', {id: document.id}) }}" class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-info/10 px-3 py-2 text-sm font-semibold text-info">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        Preuzmi
                                    </a>
                                {% endif %}
                                <a href="{{ path('document_edit', {id: document.id}) }}" class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M4 20h4l11-11a2.8 2.8 0 0 0-4-4L4 16v4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                        <path d="m13.5 6.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                    Uredi
                                </a>
                            </div>
                        </article>
                    {% else %}
                        <div class="rounded border border-dashed border-black/10 p-6 text-center text-sm text-muted dark:border-darkborder md:col-span-2 xl:col-span-3">Ovo vozilo još nema unesenih dokumenata.</div>
                    {% endfor %}
                </div>
            </div>

            <div id="vehicle-tires" class="vehicle-edit-panel">
                <form method="post" action="{{ path('vehicle_tires_update', {id: vehicle.id}) }}" class="space-y-3" data-vehicle-tires-form>
                    <input type="hidden" name="_token" value="{{ csrf_token('update_vehicle_tires_' ~ vehicle.id) }}">
                    <div class="space-y-3" data-tire-rows>
                        {% for tire in tires %}
                            <div class="vehicle-tire-grid rounded border border-black/10 p-3 dark:border-darkborder" data-tire-row>
                                <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">Naziv gume</label><input type="text" name="tires[{{ loop.index0 }}][name]" value="{{ tire.name }}" data-name="name" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                                <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">DOT</label><input type="text" name="tires[{{ loop.index0 }}][dot]" value="{{ tire.dot }}" data-name="dot" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                                <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">Pozicija</label><input type="text" name="tires[{{ loop.index0 }}][position]" value="{{ tire.position }}" data-name="position" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                                <div>
                                    <label class="block mb-1 text-xs font-medium text-black dark:text-white">Na vozilu</label>
                                    <label class="inline-flex h-10 items-center gap-2 text-sm font-medium text-black dark:text-white">
                                        <input type="checkbox" name="tires[{{ loop.index0 }}][onVehicle]" value="1" data-name="onVehicle" class="form-checkbox outborder-purple" {% if tire.onVehicle %}checked{% endif %}>
                                        <span>Da</span>
                                    </label>
                                </div>
                                <button type="button" class="inline-flex h-10 items-center justify-center rounded bg-danger/10 px-3 text-danger" data-remove-tire-row aria-label="Ukloni gumu">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                                    </svg>
                                </button>
                            </div>
                        {% else %}
                            <div class="vehicle-tire-grid rounded border border-black/10 p-3 dark:border-darkborder" data-tire-row>
                                <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">Naziv gume</label><input type="text" name="tires[0][name]" data-name="name" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                                <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">DOT</label><input type="text" name="tires[0][dot]" data-name="dot" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                                <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">Pozicija</label><input type="text" name="tires[0][position]" data-name="position" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                                <div>
                                    <label class="block mb-1 text-xs font-medium text-black dark:text-white">Na vozilu</label>
                                    <label class="inline-flex h-10 items-center gap-2 text-sm font-medium text-black dark:text-white">
                                        <input type="checkbox" name="tires[0][onVehicle]" value="1" data-name="onVehicle" class="form-checkbox outborder-purple">
                                        <span>Da</span>
                                    </label>
                                </div>
                                <button type="button" class="inline-flex h-10 items-center justify-center rounded bg-danger/10 px-3 text-danger" data-remove-tire-row aria-label="Ukloni gumu">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                                    </svg>
                                </button>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <button type="button" class="inline-flex items-center justify-center gap-2 rounded bg-purple/10 px-3 py-2 text-sm font-semibold text-purple" data-add-tire-row>
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                            Nova guma
                        </button>
                        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded bg-purple px-4 py-2 text-sm font-semibold text-white">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 4h12l2 2v14H5V4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M8 4v6h8M8 20v-6h8v6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                            Spremi gume
                        </button>
                    </div>
                </form>

                <template data-tire-row-template>
                    <div class="vehicle-tire-grid rounded border border-black/10 p-3 dark:border-darkborder" data-tire-row>
                        <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">Naziv gume</label><input type="text" data-name="name" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                        <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">DOT</label><input type="text" data-name="dot" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                        <div><label class="block mb-1 text-xs font-medium text-black dark:text-white">Pozicija</label><input type="text" data-name="position" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10 dark:border-darkborder"></div>
                        <div>
                            <label class="block mb-1 text-xs font-medium text-black dark:text-white">Na vozilu</label>
                            <label class="inline-flex h-10 items-center gap-2 text-sm font-medium text-black dark:text-white">
                                <input type="checkbox" value="1" data-name="onVehicle" class="form-checkbox outborder-purple">
                                <span>Da</span>
                            </label>
                        </div>
                        <button type="button" class="inline-flex h-10 items-center justify-center rounded bg-danger/10 px-3 text-danger" data-remove-tire-row aria-label="Ukloni gumu">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                </template>
            </div>

            <div id="vehicle-fuel" class="vehicle-edit-panel">
                <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <h3 class="text-base font-semibold text-black dark:text-white">Gorivo</h3>
                        <p class="mt-1 text-sm text-muted">Potrošnja se računa tek od drugog unosa, na osnovu razlike kilometraže.</p>
                    </div>
                    <button type="button" class="inline-flex items-center justify-center gap-2 rounded bg-purple px-3 py-2 text-sm font-semibold text-white" data-fuel-open>
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                        </svg>
                        Dodaj gorivo
                    </button>
                </div>

                <div class="space-y-3">
                    {% for row in fuel_entries %}
                        {% set entry = row.entry %}
                        <article class="vehicle-fuel-row rounded border border-black/10 p-3 dark:border-darkborder">
                            <div>
                                <p class="text-[11px] font-semibold uppercase text-muted">Datum</p>
                                <p class="mt-1 font-semibold text-black dark:text-white">{{ entry.entryDate|date('d.m.Y') }}</p>
                            </div>
                            <div>
                                <p class="text-[11px] font-semibold uppercase text-muted">Gorivo</p>
                                <p class="mt-1 text-black dark:text-white">{{ entry.liters|number_format(2, ',', '.') }} L / {{ entry.amountBam|number_format(2, ',', '.') }} KM</p>
                            </div>
                            <div>
                                <p class="text-[11px] font-semibold uppercase text-muted">Kilometraža</p>
                                <p class="mt-1 text-black dark:text-white">{{ entry.odometerKm|number_format(0, ',', '.') }} km</p>
                            </div>
                            <div>
                                <p class="text-[11px] font-semibold uppercase text-muted">Potrošnja</p>
                                {% if row.consumption is not null %}
                                    <p class="mt-1 font-semibold text-success">{{ row.consumption|number_format(2, ',', '.') }} L/100 km</p>
                                    <p class="mt-1 text-xs text-muted">{{ row.distanceKm|number_format(0, ',', '.') }} km od prethodnog unosa · {{ row.costPer100Km|number_format(2, ',', '.') }} KM/100 km</p>
                                {% else %}
                                    <p class="mt-1 text-sm text-muted">Potrebna su najmanje dva unosa.</p>
                                {% endif %}
                            </div>
                            <form method="post" action="{{ path('vehicle_fuel_delete', {vehicleId: vehicle.id, fuelId: entry.id}) }}" onsubmit="return confirm('Jeste li sigurni da želite obrisati ovaj unos goriva?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_vehicle_fuel_' ~ entry.id) }}">
                                <button type="submit" class="inline-flex h-10 items-center justify-center rounded bg-danger/10 px-3 text-danger" aria-label="Obriši unos goriva">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M6 7h12M10 11v6M14 11v6M9 7l1-3h4l1 3M8 7l1 13h6l1-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            </form>
                        </article>
                    {% else %}
                        <div class="rounded border border-dashed border-black/10 p-6 text-center text-sm text-muted dark:border-darkborder">
                            Još nema unosa goriva za ovo vozilo.
                        </div>
                    {% endfor %}
                </div>

                <div class="vehicle-fuel-modal-backdrop" data-fuel-modal>
                    <div class="vehicle-fuel-modal">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h3 class="text-base font-semibold text-black">Dodaj gorivo</h3>
                                <p class="mt-1 text-sm text-muted">Unesite stanje kilometraže vozila pri točenju.</p>
                            </div>
                            <button type="button" class="rounded px-2 py-1 text-xl leading-none text-muted" data-fuel-close>&times;</button>
                        </div>

                        <form method="post" action="{{ path('vehicle_fuel_add', {id: vehicle.id}) }}" class="mt-4 space-y-4" data-fuel-form>
                            <input type="hidden" name="_token" value="{{ csrf_token('add_vehicle_fuel_' ~ vehicle.id) }}">

                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <div>
                                    <label for="fuel-entry-date" class="block mb-1 text-xs font-medium text-black">Datum</label>
                                    <input id="fuel-entry-date" type="date" name="entryDate" value="{{ 'now'|date('Y-m-d') }}" required class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10">
                                </div>
                                <div>
                                    <label for="fuel-odometer" class="block mb-1 text-xs font-medium text-black">Kilometraža vozila</label>
                                    <input id="fuel-odometer" type="number" min="1" step="1" name="odometerKm" required class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10" data-fuel-odometer>
                                </div>
                                <div>
                                    <label for="fuel-liters" class="block mb-1 text-xs font-medium text-black">Litara</label>
                                    <input id="fuel-liters" type="number" min="0.01" step="0.01" name="liters" required class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10" data-fuel-liters>
                                </div>
                                <div>
                                    <label for="fuel-amount" class="block mb-1 text-xs font-medium text-black">Iznos KM</label>
                                    <input id="fuel-amount" type="number" min="0" step="0.01" name="amountBam" required class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10" data-fuel-amount>
                                </div>
                            </div>

                            <div>
                                <label for="fuel-notes" class="block mb-1 text-xs font-medium text-black">Napomena</label>
                                <textarea id="fuel-notes" name="notes" rows="2" class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10"></textarea>
                            </div>

                            <div class="rounded bg-info/10 px-3 py-2 text-sm text-info" data-fuel-preview data-last-odometer="{{ fuel_entries|length ? fuel_entries[0].entry.odometerKm : '' }}">
                                Potrošnja će biti dostupna nakon drugog unosa.
                            </div>

                            <div class="flex gap-2">
                                <button type="button" class="inline-flex flex-1 items-center justify-center rounded bg-black/5 px-4 py-2 text-sm font-semibold text-black" data-fuel-close>Odustani</button>
                                <button type="submit" class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-purple px-4 py-2 text-sm font-semibold text-white">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 4h12l2 2v14H5V4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                        <path d="M8 4v6h8M8 20v-6h8v6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                    </svg>
                                    Spremi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script>
        (() => {
            const root = document.querySelector('[data-vehicle-edit-tabs]');
            if (!root) return;
            const tabs = Array.from(root.querySelectorAll('[data-tab-target]'));
            const panels = Array.from(root.querySelectorAll('.vehicle-edit-panel'));
            const activate = (id) => {
                tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.tabTarget === id));
                panels.forEach((panel) => panel.classList.toggle('is-active', panel.id === id));
            };
            tabs.forEach((tab) => tab.addEventListener('click', () => {
                activate(tab.dataset.tabTarget);
                window.history.replaceState(null, '', `#${tab.dataset.tabTarget}`);
            }));
            if (window.location.hash) {
                const id = window.location.hash.replace('#', '');
                if (panels.some((panel) => panel.id === id)) activate(id);
            }
        })();

        (() => {
            const form = document.querySelector('[data-vehicle-tires-form]');
            if (!form) return;
            const rows = form.querySelector('[data-tire-rows]');
            const template = document.querySelector('[data-tire-row-template]');
            const addButton = form.querySelector('[data-add-tire-row]');
            const reindex = () => {
                Array.from(rows.querySelectorAll('[data-tire-row]')).forEach((row, index) => {
                    row.querySelectorAll('[data-name]').forEach((input) => {
                        input.name = `tires[${index}][${input.dataset.name}]`;
                    });
                });
            };
            addButton.addEventListener('click', () => {
                const row = template.content.firstElementChild.cloneNode(true);
                rows.appendChild(row);
                reindex();
                row.querySelector('input').focus();
            });
            rows.addEventListener('click', (event) => {
                const button = event.target.closest('[data-remove-tire-row]');
                if (!button) return;
                const row = button.closest('[data-tire-row]');
                if (rows.querySelectorAll('[data-tire-row]').length === 1) {
                    row.querySelectorAll('input').forEach((input) => {
                        if (input.type === 'checkbox') {
                            input.checked = false;
                            return;
                        }

                        input.value = '';
                    });
                    return;
                }
                row.remove();
                reindex();
            });
            reindex();
        })();

        (() => {
            const modal = document.querySelector('[data-fuel-modal]');
            const openButton = document.querySelector('[data-fuel-open]');
            const form = document.querySelector('[data-fuel-form]');
            const preview = document.querySelector('[data-fuel-preview]');

            if (!modal || !openButton || !form || !preview) return;

            const close = () => modal.classList.remove('is-open');
            const open = () => {
                modal.classList.add('is-open');
                form.querySelector('[data-fuel-odometer]')?.focus();
                updatePreview();
            };
            const numberValue = (selector) => Number(String(form.querySelector(selector)?.value || '').replace(',', '.'));
            const updatePreview = () => {
                const lastOdometer = Number(preview.dataset.lastOdometer || 0);
                const odometer = numberValue('[data-fuel-odometer]');
                const liters = numberValue('[data-fuel-liters]');
                const amount = numberValue('[data-fuel-amount]');

                if (!lastOdometer) {
                    preview.textContent = 'Ovo je prvi unos. Potrošnja će se računati od sljedećeg unosa.';
                    return;
                }

                const distance = odometer - lastOdometer;

                if (distance <= 0 || liters <= 0) {
                    preview.textContent = 'Unesite kilometražu veću od zadnjeg unosa da bi se izračunala potrošnja.';
                    return;
                }

                const consumption = (liters / distance) * 100;
                const cost = amount > 0 ? (amount / distance) * 100 : 0;
                preview.textContent = `Procjena: ${consumption.toFixed(2)} L/100 km · ${cost.toFixed(2)} KM/100 km · ${distance} km od zadnjeg unosa`;
            };

            openButton.addEventListener('click', open);
            document.querySelectorAll('[data-fuel-close]').forEach((button) => button.addEventListener('click', close));
            form.querySelectorAll('input').forEach((input) => input.addEventListener('input', updatePreview));
            modal.addEventListener('click', (event) => {
                if (event.target === modal) close();
            });
            window.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') close();
            });
        })();
    </script>
{% endblock %}
