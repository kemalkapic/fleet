{% extends 'base.html.twig' %}

{% block title %}Profil | {{ app_name }}{% endblock %}

{% block body %}
    {% set field_label_class = 'mb-1.5 block text-xs font-semibold text-black dark:text-white' %}
    {% set field_input_class = 'w-full rounded border border-black/10 bg-transparent px-3 py-2.5 text-sm outline-none transition focus:border-purple dark:border-darkborder' %}

    <div class="mx-auto w-full max-w-4xl">
        <section class="overflow-hidden rounded border border-black/10 bg-white shadow-sm dark:border-darkborder dark:bg-darklight">
            <div class="flex items-center gap-3 border-b border-black/10 px-4 py-4 dark:border-darkborder sm:px-5">
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded bg-purple/10 text-base font-bold text-purple">
                    {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                </span>
                <div class="min-w-0">
                    <h2 class="truncate text-lg font-semibold text-black dark:text-white">Moj profil</h2>
                    <p class="mt-0.5 text-xs text-muted">Uredite svoje lične podatke.</p>
                </div>
            </div>

            <div class="grid gap-5 p-4 sm:p-5 lg:grid-cols-[minmax(0,1fr)_280px]">
                {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            {{ form_label(form.firstName, null, {label_attr: {class: field_label_class}}) }}
                            {{ form_widget(form.firstName, {attr: {class: field_input_class, autocomplete: 'given-name'}}) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                        <div>
                            {{ form_label(form.lastName, null, {label_attr: {class: field_label_class}}) }}
                            {{ form_widget(form.lastName, {attr: {class: field_input_class, autocomplete: 'family-name'}}) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-black dark:text-white">Email adresa</label>
                        <div class="flex min-h-[42px] items-center rounded border border-black/10 bg-black/[0.025] px-3 text-sm text-muted dark:border-darkborder dark:bg-white/[0.04]">
                            {{ user.email }}
                        </div>
                        <p class="mt-1 text-[11px] text-muted">Email adresu može promijeniti administrator.</p>
                    </div>

                    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded bg-purple px-4 py-2.5 text-sm font-semibold text-white shadow-sm">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 4h12l2 2v14H5V4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                            <path d="M8 4v6h8M8 20v-6h8v6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        </svg>
                        Spremi promjene
                    </button>
                {{ form_end(form) }}

                <aside class="rounded border border-black/10 bg-black/[0.025] p-4 dark:border-darkborder dark:bg-white/[0.03]">
                    <h3 class="text-xs font-bold uppercase text-muted">Korisnički račun</h3>
                    <dl class="mt-3 space-y-3">
                        <div>
                            <dt class="text-[11px] text-muted">Firma</dt>
                            <dd class="mt-0.5 text-sm font-semibold text-black dark:text-white">{{ user.company ? user.company.name : 'Platforma' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] text-muted">Uloga</dt>
                            <dd class="mt-0.5 text-sm font-semibold text-black dark:text-white">{{ role_label }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] text-muted">Zadnja aktivnost</dt>
                            <dd class="mt-0.5 text-sm font-semibold text-black dark:text-white">{{ user.lastActiveAt ? user.lastActiveAt|date('d.m.Y. H:i') : 'Nije zabilježena' }}</dd>
                        </div>
                        <div>
                            <dt class="text-[11px] text-muted">Uvjeti korištenja</dt>
                            <dd class="mt-1">
                                {% if user.termsAcceptedAt %}
                                    <span class="inline-flex rounded bg-success/10 px-2 py-1 text-[11px] font-semibold text-success">Prihvaćeni</span>
                                    <span class="mt-1 block text-xs font-medium text-black dark:text-white">{{ user.termsAcceptedAt|date('d.m.Y. H:i') }}</span>
                                {% else %}
                                    <span class="inline-flex rounded bg-danger/10 px-2 py-1 text-[11px] font-semibold text-danger">Nisu prihvaćeni</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </aside>
            </div>
        </section>
    </div>
{% endblock %}
