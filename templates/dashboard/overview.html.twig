{% extends 'base.html.twig' %}

{% block title %}Kontrolna tabla | {{ app_name }}{% endblock %}
{% block page_title %}Kontrolna tabla{% endblock %}

{% block body %}
    <style>
        .dashboard-stat-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-main-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: minmax(0, 1fr);
        }

        .dashboard-upcoming-row {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: minmax(130px, 1fr) minmax(120px, 1fr) 120px 140px;
            align-items: center;
        }

        .dashboard-expired-row {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: minmax(130px, 1fr) minmax(120px, 1fr) 120px 110px;
            align-items: center;
        }

        .dashboard-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: rgba(15, 23, 42, 0.55);
        }

        .dashboard-modal-backdrop.is-open {
            display: flex;
        }

        .dashboard-modal {
            width: min(100%, 430px);
            border-radius: 8px;
            background: #fff;
            border: 1px solid rgba(0, 0, 0, 0.1);
            padding: 1rem;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
        }

        .dashboard-stat-icon {
            width: 3.25rem;
            height: 3.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 3.25rem;
            border-radius: 8px;
        }

        .dashboard-stat-icon svg {
            width: 1.95rem;
            height: 1.95rem;
            display: block;
            stroke: currentColor;
        }

        .dashboard-stat-card,
        [data-dashboard-document-url] {
            transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
        }

        .dashboard-stat-card:hover,
        .dashboard-stat-card:focus-visible,
        [data-dashboard-document-url]:hover,
        [data-dashboard-document-url]:focus-visible {
            border-color: rgba(106, 90, 249, 0.45);
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.08);
            outline: none;
        }

        [data-dashboard-document-url] {
            cursor: pointer;
        }

        .dashboard-expired-section {
            order: 1;
        }

        .dashboard-upcoming-section {
            order: 2;
        }

        .dashboard-upcoming-scroll,
        .dashboard-expired-scroll {
            max-height: 310px;
            overflow-y: auto;
            padding-right: 0.375rem;
            scrollbar-gutter: stable;
        }

        .dashboard-upcoming-scroll::-webkit-scrollbar,
        .dashboard-expired-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .dashboard-upcoming-scroll::-webkit-scrollbar-thumb,
        .dashboard-expired-scroll::-webkit-scrollbar-thumb {
            border-radius: 6px;
            background: rgba(107, 114, 128, 0.35);
        }

        @media (min-width: 1280px) {
            .dashboard-stat-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .dashboard-main-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 520px) {
            .dashboard-stat-card {
                padding: 0.875rem;
            }

            .dashboard-stat-card h2 {
                font-size: 1.5rem;
                line-height: 2rem;
            }

            .dashboard-stat-card p {
                font-size: 0.8125rem;
            }

            .dashboard-stat-icon {
                width: 2.65rem;
                height: 2.65rem;
                flex-basis: 2.65rem;
            }

            .dashboard-stat-icon svg {
                width: 1.55rem;
                height: 1.55rem;
            }
        }

        @media (max-width: 760px) {
            .dashboard-upcoming-row,
            .dashboard-expired-row {
                grid-template-columns: 1fr;
                align-items: start;
            }

            .dashboard-upcoming-scroll,
            .dashboard-expired-scroll {
                max-height: 590px;
            }
        }
    </style>

    <div class="dashboard-stat-grid">
        <a href="{{ path('vehicle_index') }}" class="dashboard-stat-card block p-5 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10">
            <p class="text-muted">Broj vozila</p>
            <div class="flex items-end justify-between mt-4">
                <h2 class="text-3xl font-semibold text-black dark:text-white">{{ stats.vehicles }}/{{ stats.vehicleLimit is not null ? stats.vehicleLimit : '∞' }}</h2>
                <span class="dashboard-stat-icon text-info bg-info/10">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 7h11v9H3z"></path>
                        <path d="M14 10h3l3 3v3h-6z"></path>
                        <path d="M6.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
                        <path d="M17.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
                    </svg>
                </span>
            </div>
            {% if stats.vehicleLimit is not null and stats.vehicles >= stats.vehicleLimit %}
                <span class="mt-3 inline-flex rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">Kontaktiraj admina za još vozila</span>
            {% endif %}
        </a>

        <a href="{{ path('driver_index') }}" class="dashboard-stat-card block p-5 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10">
            <p class="text-muted">Broj vozača</p>
            <div class="flex items-end justify-between mt-4">
                <h2 class="text-3xl font-semibold text-black dark:text-white">{{ stats.drivers }}/{{ stats.driverLimit is not null ? stats.driverLimit : '∞' }}</h2>
                <span class="dashboard-stat-icon text-success bg-success/10">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"></path>
                        <path d="M4 20a8 8 0 0 1 16 0"></path>
                        <path d="M17.5 8.5h2"></path>
                        <path d="M18.5 7.5v2"></path>
                    </svg>
                </span>
            </div>
            {% if stats.driverLimit is not null and stats.drivers >= stats.driverLimit %}
                <span class="mt-3 inline-flex rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">Kontaktiraj admina za još vozača</span>
            {% endif %}
        </a>

        <a href="{{ path('document_index') }}" class="dashboard-stat-card block p-5 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10">
            <p class="text-muted">Broj evidencija</p>
            <div class="flex items-end justify-between mt-4">
                <h2 class="text-3xl font-semibold text-black dark:text-white">{{ stats.documents }}/{{ stats.documentLimit is not null ? stats.documentLimit : '∞' }}</h2>
                <span class="dashboard-stat-icon text-purple bg-purple/10">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 3h7l4 4v14H7z"></path>
                        <path d="M14 3v5h5"></path>
                        <path d="M10 12h6"></path>
                        <path d="M10 16h6"></path>
                    </svg>
                </span>
            </div>
            {% if stats.documentLimit is not null and stats.documents >= stats.documentLimit %}
                <span class="mt-3 inline-flex rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">Kontaktiraj admina za još dokumenata</span>
            {% endif %}
        </a>

        <a href="{{ path('notification_index') }}" class="dashboard-stat-card block p-5 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10">
            <p class="text-muted">Poslane notifikacije</p>
            <div class="flex items-end justify-between mt-4">
                <h2 class="text-3xl font-semibold text-black dark:text-white">{{ stats.sentNotifications }}</h2>
                <span class="dashboard-stat-icon text-warning bg-warning/10">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                        <path d="M10 21h4"></path>
                        <path d="M14.5 3.5 16 2"></path>
                    </svg>
                </span>
            </div>
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mt-4 rounded bg-success/10 p-3 text-sm text-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mt-4 rounded bg-danger/10 p-3 text-sm text-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="dashboard-main-grid mt-4">
        <section class="dashboard-upcoming-section p-4 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-5">
            <div class="mb-5">
                <div>
                    <h2 class="text-base font-semibold text-black dark:text-white">Nadolazeća upozorenja</h2>
                    <p class="text-sm text-muted">Dokumenti koji najbliže ističu.</p>
                </div>
            </div>

            <div class="space-y-3{{ upcoming_documents|length > 3 ? ' dashboard-upcoming-scroll' : '' }}">
                {% for document in upcoming_documents %}
                    {% set diff = today.diff(document.validUntil) %}
                    {% set days_left = diff.invert ? -diff.days : diff.days %}
                    <article class="dashboard-upcoming-row rounded border border-black/10 p-3 dark:border-darkborder">
                        <div>
                            <p class="font-semibold text-black dark:text-white">{{ document.typeLabel }}</p>
                            <p class="mt-1 text-xs text-muted">{{ document.documentNumber ?: 'Broj nije upisan' }}</p>
                        </div>
                        <div>
                            <p class="text-sm text-black dark:text-white">{{ document.ownerLabel }}</p>
                            <p class="mt-1 text-xs text-muted">{{ document.ownerType == 'driver' ? 'Vozač' : 'Vozilo' }}</p>
                        </div>
                        <div class="text-sm text-black dark:text-white">{{ document.validUntil|date('d.m.Y') }}</div>
                        <div>
                            {% if days_left == 0 %}
                                <span class="inline-flex rounded bg-danger/10 px-2 py-1 text-xs font-semibold text-danger">ističe danas</span>
                            {% elseif days_left == 1 %}
                                <span class="inline-flex rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">do isteka 1 dan</span>
                            {% else %}
                                <span class="inline-flex rounded bg-info/10 px-2 py-1 text-xs font-semibold text-info">do isteka {{ days_left }} dana</span>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    <div class="rounded border border-dashed border-black/10 p-6 text-center text-muted dark:border-darkborder">
                        Nema nadolazećih isteka dokumenata.
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="dashboard-expired-section p-4 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-5">
            <div class="mb-5">
                <h2 class="text-base font-semibold text-black dark:text-white">Istekli dokumenti</h2>
                <p class="text-sm text-muted">Dokumenti koje treba produžiti u sistemu.</p>
            </div>

            <div class="space-y-3{{ expired_documents|length > 3 ? ' dashboard-expired-scroll' : '' }}">
                {% for document in expired_documents %}
                    {% set expired_diff = document.validUntil.diff(today) %}
                    <article class="dashboard-expired-row rounded border border-danger/20 bg-danger/5 p-3" data-dashboard-document-url="{{ path('document_edit', {id: document.id}) }}" tabindex="0" role="link" aria-label="Uredi dokument {{ document.typeLabel }}">
                        <div>
                            <p class="font-semibold text-black dark:text-white">{{ document.typeLabel }}</p>
                            <p class="mt-1 text-xs text-muted">{{ document.documentNumber ?: 'Broj nije upisan' }}</p>
                        </div>
                        <div>
                            <p class="text-sm text-black dark:text-white">{{ document.ownerLabel }}</p>
                            <p class="mt-1 text-xs text-muted">{{ document.ownerType == 'driver' ? 'Vozač' : 'Vozilo' }}</p>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-danger">{{ document.validUntil|date('d.m.Y') }}</p>
                            <p class="mt-1 text-xs text-muted">prije {{ expired_diff.days }} dana</p>
                        </div>
                        <div>
                            <button
                                type="button"
                                class="inline-flex w-full items-center justify-center rounded bg-purple px-3 py-2 text-sm font-semibold text-white"
                                data-expiry-open
                                data-action="{{ path('document_update_expiry', {id: document.id}) }}"
                                data-token="{{ csrf_token('update_document_expiry_' ~ document.id) }}"
                                data-title="{{ document.typeLabel }} - {{ document.ownerLabel }}"
                            >
                                Produži
                            </button>
                        </div>
                    </article>
                {% else %}
                    <div class="rounded border border-dashed border-black/10 p-6 text-center text-muted dark:border-darkborder">
                        Nema isteklih dokumenata.
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <section class="mt-4 p-4 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-5">
        <h2 class="text-base font-semibold text-black dark:text-white">Zadnje notifikacije</h2>
        <div class="mt-4 grid grid-cols-1 gap-3 lg:grid-cols-3">
            {% for notification in latest_notifications %}
                <article class="rounded border border-black/10 p-3 dark:border-darkborder">
                    <div class="flex items-center justify-between gap-3">
                        {% if notification.status == 'sent' %}
                            <span class="inline-flex rounded bg-success/10 px-2 py-1 text-xs font-semibold text-success">Poslano</span>
                        {% elseif notification.status == 'failed' %}
                            <span class="inline-flex rounded bg-danger/10 px-2 py-1 text-xs font-semibold text-danger">Greška</span>
                        {% else %}
                            <span class="inline-flex rounded bg-warning/10 px-2 py-1 text-xs font-semibold text-warning">{{ notification.status }}</span>
                        {% endif %}
                        <span class="text-xs text-muted">{{ notification.sentAt ? notification.sentAt|date('d.m.Y H:i') : '-' }}</span>
                    </div>
                    <p class="mt-2 text-xs leading-5 text-muted">{{ notification.messageText }}</p>
                </article>
            {% else %}
                <p class="text-sm text-muted">Još nema poslanih notifikacija.</p>
            {% endfor %}
        </div>
    </section>

    <section class="mt-4 p-4 bg-white border rounded dark:bg-darklight dark:border-darkborder border-black/10 sm:p-5">
        <div>
            <h2 class="text-base font-semibold text-black dark:text-white">Rokovi u narednih 6 mjeseci</h2>
            <p class="mt-1 text-sm text-muted">Broj evidencija koje ističu po mjesecima.</p>
        </div>
        <div id="document-expiry-chart" class="mt-4" style="min-height: 280px;"></div>
    </section>

    <div class="dashboard-modal-backdrop" data-expiry-modal>
        <div class="dashboard-modal">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-base font-semibold text-black">Produži dokument</h2>
                    <p class="mt-1 text-sm text-muted" data-expiry-modal-title></p>
                </div>
                <button type="button" class="rounded px-2 py-1 text-xl leading-none text-muted" data-expiry-close>&times;</button>
            </div>

            <form method="post" class="mt-4 space-y-4" data-expiry-form>
                <input type="hidden" name="_token" data-expiry-token>

                <div>
                    <label for="dashboard-valid-until" class="block mb-1 text-xs font-medium text-black">Novi datum isteka</label>
                    <input id="dashboard-valid-until" type="date" name="validUntil" required class="w-full px-3 py-2 text-sm bg-transparent border rounded outline-none border-black/10" data-expiry-date>
                </div>

                <div class="flex gap-2">
                    <button type="button" class="inline-flex flex-1 items-center justify-center rounded bg-black/5 px-4 py-2 text-sm font-semibold text-black" data-expiry-close>
                        Odustani
                    </button>
                    <button type="submit" class="inline-flex flex-1 items-center justify-center rounded bg-purple px-4 py-2 text-sm font-semibold text-white">
                        Sačuvaj
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="{{ asset('assets/js/apexcharts.js') }}"></script>
    <script>
        (() => {
            const chartElement = document.querySelector('#document-expiry-chart');

            if (!chartElement || typeof ApexCharts === 'undefined') {
                return;
            }

            const chart = new ApexCharts(chartElement, {
                chart: {
                    type: 'bar',
                    height: 300,
                    fontFamily: 'inherit',
                    toolbar: { show: false },
                },
                series: [{
                    name: 'Evidencije',
                    data: {{ expiry_chart_values|json_encode|raw }},
                }],
                colors: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444', '#06b6d4'],
                plotOptions: {
                    bar: {
                        borderRadius: 4,
                        columnWidth: '46%',
                        distributed: true,
                    },
                },
                dataLabels: {
                    enabled: true,
                    formatter: (value) => value > 0 ? value : '',
                    style: { fontSize: '12px' },
                },
                legend: { show: false },
                grid: {
                    borderColor: '#e5e7eb',
                    strokeDashArray: 4,
                },
                xaxis: {
                    categories: {{ expiry_chart_labels|json_encode|raw }},
                    labels: {
                        rotate: -35,
                        style: { colors: '#6b7280', fontSize: '12px' },
                    },
                    axisBorder: { show: false },
                    axisTicks: { show: false },
                },
                yaxis: {
                    min: 0,
                    forceNiceScale: true,
                    labels: {
                        formatter: (value) => Number.isInteger(value) ? value : '',
                        style: { colors: '#6b7280' },
                    },
                },
                tooltip: {
                    y: {
                        formatter: (value) => `${value} evidencija`,
                    },
                },
                responsive: [{
                    breakpoint: 640,
                    options: {
                        chart: { height: 270 },
                        plotOptions: { bar: { columnWidth: '58%' } },
                    },
                }],
            });

            chart.render();
        })();

        document.querySelectorAll('[data-dashboard-document-url]').forEach((row) => {
            const openDocument = () => {
                window.location.href = row.dataset.dashboardDocumentUrl || '';
            };

            row.addEventListener('click', (event) => {
                if (event.target.closest('a, button, input, select, textarea, form')) {
                    return;
                }

                openDocument();
            });

            row.addEventListener('keydown', (event) => {
                if ((event.key === 'Enter' || event.key === ' ') && !event.target.closest('button, input, select, textarea')) {
                    event.preventDefault();
                    openDocument();
                }
            });
        });

        (() => {
            const modal = document.querySelector('[data-expiry-modal]');
            const form = document.querySelector('[data-expiry-form]');
            const token = document.querySelector('[data-expiry-token]');
            const title = document.querySelector('[data-expiry-modal-title]');
            const date = document.querySelector('[data-expiry-date]');

            if (!modal || !form || !token || !title || !date) {
                return;
            }

            const close = () => {
                modal.classList.remove('is-open');
                form.removeAttribute('action');
                token.value = '';
                date.value = '';
            };

            document.querySelectorAll('[data-expiry-open]').forEach((button) => {
                button.addEventListener('click', () => {
                    form.action = button.dataset.action || '';
                    token.value = button.dataset.token || '';
                    title.textContent = button.dataset.title || '';
                    modal.classList.add('is-open');
                    date.focus();
                });
            });

            document.querySelectorAll('[data-expiry-close]').forEach((button) => {
                button.addEventListener('click', close);
            });

            modal.addEventListener('click', (event) => {
                if (event.target === modal) {
                    close();
                }
            });

            window.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    close();
                }
            });
        })();
    </script>
{% endblock %}
